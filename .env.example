# 数据库 (默认 SQLite, 可选 MySQL)
DATABASE_URL=sqlite:///data/netease163.db

# 服务端口
API_HOST=0.0.0.0
API_PORT=9700

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 可选: 网易云登录 (如需登录态功能, 如收藏歌单/关注用户)
# NETEASE_PHONE=13800138000
# NETEASE_PASSWORD=xxxxxxxx
# NETEASE_EMAIL=

# 可选: MySQL (如用 MySQL 替代 SQLite)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DB=netease163
